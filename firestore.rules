rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidProduct(data) {
      return data.name is string && data.name.size() >= 3 && data.name.size() <= 200
        && data.slug is string && data.slug.matches('^[a-z0-9-]+$')
        && data.sku is string && data.sku.size() <= 50
        && data.categoryId is string
        && data.brandId is string
        && (data.price == null || data.price is number)
        && (data.currency == null || data.currency.matches('^[A-Z]{3}$'));
    }

    function isValidEnquiry(data) {
      return data.type in ['bulk', 'project', 'cable', 'quote']
        && data.status in ['pending', 'reviewing', 'quoted', 'closed']
        && data.customerInfo is map
        && data.data is map
        && data.userId == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.uid == request.auth.uid
        && data.email is string
        && data.role in ['customer', 'admin'];
    }

    // --- Collections ---

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn() && isValidEnquiry(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin() || (
        isSignedIn() && existing().userId == request.auth.uid 
        && isValidEnquiry(incoming())
        && incoming().status == existing().status // Customer cannot change status
        && incoming().diff(existing()).affectedKeys().hasOnly(['data', 'customerInfo', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUserProfile(incoming()) && incoming().role == 'customer';
      allow update: if isAdmin() || (
        isOwner(userId) 
        && isValidUserProfile(incoming())
        && incoming().role == existing().role // Cannot change own role
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'company', 'phone', 'jobTitle', 'address', 'shippingAddress', 'billingAddress', 'taxId', 'vatNumber', 'wishlist', 'updatedAt'])
      );
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      // Allow the first admin to be created if the collection is empty
      // In production, this should be disabled after setup
      allow create: if isSignedIn() && isOwner(adminId);
      allow write: if false;
    }
  }
}
